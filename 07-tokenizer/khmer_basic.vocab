[ប្រទេសកម្ពុជា ឬ ព្រះរាជាណាចក្រកម្ពុជា ស្ថិតនៅក្នុងតំបន់អាស៊ីអាគ្នេយ៍។\u000aរាជធានីរបស់ប្រទេសកម្ពុជាគឺទីក្រុងភ្នំពេញ។\u000aភាសាខ្មែរជាភាសាផ្លូវការរបស់ប្រទេសកម្ពុជា។\u000aអក្សរខ្មែរមានព្យញ្ជនៈ និងស្រៈ ច្រើនណាស់។\u000a\u000aសួស្តី! តើអ្នក][សុខសប្បាយជាទេ] -> [ប្រទេសកម្ពុជា ឬ ព្រះរាជាណាចក្រកម្ពុជា ស្ថិតនៅក្នុងតំបន់អាស៊ីអាគ្នេយ៍។\u000aរាជធានីរបស់ប្រទេសកម្ពុជាគឺទីក្រុងភ្នំពេញ។\u000aភាសាខ្មែរជាភាសាផ្លូវការរបស់ប្រទេសកម្ពុជា។\u000aអក្សរខ្មែរមានព្យញ្ជនៈ និងស្រៈ ច្រើនណាស់។\u000a\u000aសួស្តី! តើអ្នកសុខសប្បាយជាទេ] 505
[ប្រទេសកម្ពុជា ឬ ព្រះរាជាណាចក្រកម្ពុជា ស្ថិតនៅក្នុងតំបន់អាស៊ីអាគ្នេយ៍។\u000aរាជធានីរបស់ប្រទេសកម្ពុជាគឺទីក្រុងភ្នំពេញ។\u000aភាសាខ្មែរជាភាសាផ្លូវការរបស់ប្រទេសកម្ពុជា។\u000aអក្សរខ្មែរមានព្យញ្ជនៈ និងស្រៈ ច្រើនណាស់។\u000a\u000aសួស្តី! តើអ្នកសុខសប្បាយជាទេ][?] -> [ប្រទេសកម្ពុជា ឬ ព្រះរាជាណាចក្រកម្ពុជា ស្ថិតនៅក្នុងតំបន់អាស៊ីអាគ្នេយ៍។\u000aរាជធានីរបស់ប្រទេសកម្ពុជាគឺទីក្រុងភ្នំពេញ។\u000aភាសាខ្មែរជាភាសាផ្លូវការរបស់ប្រទេសកម្ពុជា។\u000aអក្សរខ្មែរមានព្យញ្ជនៈ និងស្រៈ ច្រើនណាស់។\u000a\u000aសួស្តី! តើអ្នកសុខសប្បាយជាទេ?] 506
[ប្រទេសកម្ពុជា ឬ ព្រះរាជាណាចក្រកម្ពុជា ស្ថិតនៅក្នុងតំបន់អាស៊ីអាគ្នេយ៍។\u000aរាជធានីរបស់ប្រទេសកម្ពុជាគឺទីក្រុងភ្នំពេញ។\u000aភាសាខ្មែរជាភាសាផ្លូវការរបស់ប្រទេសកម្ពុជា។\u000aអក្សរខ្មែរមានព្យញ្ជនៈ និងស្រៈ ច្រើនណាស់។\u000a\u000aសួស្តី! តើអ្នកសុខសប្បាយជាទេ?][\u000a] -> [ប្រទេសកម្ពុជា ឬ ព្រះរាជាណាចក្រកម្ពុជា ស្ថិតនៅក្នុងតំបន់អាស៊ីអាគ្នេយ៍។\u000aរាជធានីរបស់ប្រទេសកម្ពុជាគឺទីក្រុងភ្នំពេញ។\u000aភាសាខ្មែរជាភាសាផ្លូវការរបស់ប្រទេសកម្ពុជា។\u000aអក្សរខ្មែរមានព្យញ្ជនៈ និងស្រៈ ច្រើនណាស់។\u000a\u000aសួស្តី! តើអ្នកសុខសប្បាយជាទេ?\u000a] 507
[ប្រទេសកម្ពុជា ឬ ព្រះរាជាណាចក្រកម្ពុជា ស្ថិតនៅក្នុងតំបន់អាស៊ីអាគ្នេយ៍។\u000aរាជធានីរបស់ប្រទេសកម្ពុជាគឺទីក្រុងភ្នំពេញ។\u000aភាសាខ្មែរជាភាសាផ្លូវការរបស់ប្រទេសកម្ពុជា។\u000aអក្សរខ្មែរមានព្យញ្ជនៈ និងស្រៈ ច្រើនណាស់។\u000a\u000aសួស្តី! តើអ្នកសុខសប្បាយជាទេ?\u000a][ខ្ញុំ] -> [ប្រទេសកម្ពុជា ឬ ព្រះរាជាណាចក្រកម្ពុជា ស្ថិតនៅក្នុងតំបន់អាស៊ីអាគ្នេយ៍។\u000aរាជធានីរបស់ប្រទេសកម្ពុជាគឺទីក្រុងភ្នំពេញ។\u000aភាសាខ្មែរជាភាសាផ្លូវការរបស់ប្រទេសកម្ពុជា។\u000aអក្សរខ្មែរមានព្យញ្ជនៈ និងស្រៈ ច្រើនណាស់។\u000a\u000aសួស្តី! តើអ្នកសុខសប្បាយជាទេ?\u000aខ្ញុំ] 508
[ប្រទេសកម្ពុជា ឬ ព្រះរាជាណាចក្រកម្ពុជា ស្ថិតនៅក្នុងតំបន់អាស៊ីអាគ្នេយ៍។\u000aរាជធានីរបស់ប្រទេសកម្ពុជាគឺទីក្រុងភ្នំពេញ។\u000aភាសាខ្មែរជាភាសាផ្លូវការរបស់ប្រទេសកម្ពុជា។\u000aអក្សរខ្មែរមានព្យញ្ជនៈ និងស្រៈ ច្រើនណាស់។\u000a\u000aសួស្តី! តើអ្នកសុខសប្បាយជាទេ?\u000aខ្ញុំ][សុខសប្បាយជាទេ] -> [ប្រទេសកម្ពុជា ឬ ព្រះរាជាណាចក្រកម្ពុជា ស្ថិតនៅក្នុងតំបន់អាស៊ីអាគ្នេយ៍។\u000aរាជធានីរបស់ប្រទេសកម្ពុជាគឺទីក្រុងភ្នំពេញ។\u000aភាសាខ្មែរជាភាសាផ្លូវការរបស់ប្រទេសកម្ពុជា។\u000aអក្សរខ្មែរមានព្យញ្ជនៈ និងស្រៈ ច្រើនណាស់។\u000a\u000aសួស្តី! តើអ្នកសុខសប្បាយជាទេ?\u000aខ្ញុំសុខសប្បាយជាទេ] 509
[ប្រទេសកម្ពុជា ឬ ព្រះរាជាណាចក្រកម្ពុជា ស្ថិតនៅក្នុងតំបន់អាស៊ីអាគ្នេយ៍។\u000aរាជធានីរបស់ប្រទេសកម្ពុជាគឺទីក្រុងភ្នំពេញ។\u000aភាសាខ្មែរជាភាសាផ្លូវការរបស់ប្រទេសកម្ពុជា។\u000aអក្សរខ្មែរមានព្យញ្ជនៈ និងស្រៈ ច្រើនណាស់។\u000a\u000aសួស្តី! តើអ្នកសុខសប្បាយជាទេ?\u000aខ្ញុំសុខសប្បាយជាទេ][ �] -> [ប្រទេសកម្ពុជា ឬ ព្រះរាជាណាចក្រកម្ពុជា ស្ថិតនៅក្នុងតំបន់អាស៊ីអាគ្នេយ៍។\u000aរាជធានីរបស់ប្រទេសកម្ពុជាគឺទីក្រុងភ្នំពេញ។\u000aភាសាខ្មែរជាភាសាផ្លូវការរបស់ប្រទេសកម្ពុជា។\u000aអក្សរខ្មែរមានព្យញ្ជនៈ និងស្រៈ ច្រើនណាស់។\u000a\u000aសួស្តី! តើអ្នកសុខសប្បាយជាទេ?\u000aខ្ញុំសុខសប្បាយជាទេ �] 510
[ប្រទេសកម្ពុជា ឬ ព្រះរាជាណាចក្រកម្ពុជា ស្ថិតនៅក្នុងតំបន់អាស៊ីអាគ្នេយ៍។\u000aរាជធានីរបស់ប្រទេសកម្ពុជាគឺទីក្រុងភ្នំពេញ។\u000aភាសាខ្មែរជាភាសាផ្លូវការរបស់ប្រទេសកម្ពុជា។\u000aអក្សរខ្មែរមានព្យញ្ជនៈ និងស្រៈ ច្រើនណាស់។\u000a\u000aសួស្តី! តើអ្នកសុខសប្បាយជាទេ?\u000aខ្ញុំសុខសប្បាយជាទេ �][�] -> [ប្រទេសកម្ពុជា ឬ ព្រះរាជាណាចក្រកម្ពុជា ស្ថិតនៅក្នុងតំបន់អាស៊ីអាគ្នេយ៍។\u000aរាជធានីរបស់ប្រទេសកម្ពុជាគឺទីក្រុងភ្នំពេញ។\u000aភាសាខ្មែរជាភាសាផ្លូវការរបស់ប្រទេសកម្ពុជា។\u000aអក្សរខ្មែរមានព្យញ្ជនៈ និងស្រៈ ច្រើនណាស់។\u000a\u000aសួស្តី! តើអ្នកសុខសប្បាយជាទេ?\u000aខ្ញុំសុខសប្បាយជាទេ អ] 511
