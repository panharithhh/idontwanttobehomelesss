# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,https://<your-username>.github.io

# Local SentencePiece model files (absolute or relative paths).
SP_BPE_32K_MODEL_PATH=/path/to/sp_bpe_32k.model
SP_UNIGRAM_32K_MODEL_PATH=/path/to/sp_unigram_32k.model

# HuggingFace model ids. VERIFY these before relying on them - especially
# SEA-LION and PrahokBART, whose exact current repo IDs were not confirmed
# at the time this was written. A wrong/missing id just makes that one
# tokenizer fail to load (logged, excluded) rather than crashing the app.
XLMR_MODEL_ID=xlm-roberta-base
SEALION_MODEL_ID=aisingapore/sea-lion-7b
PRAHOKBART_MODEL_ID=

MAX_INPUT_CHARS=2000
